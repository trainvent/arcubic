{
  "name": "arcubic",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:terminal": "node scripts/build-terminal.mjs",
    "build:core": "node scripts/build-core.mjs",
    "build:obsidian": "node scripts/build-obsidian.mjs",
    "build:themes": "npm run build:core && npm run build:obsidian && npm run build:terminal",
    "package:release": "python3 scripts/package-release.py"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/themes": "^3.2.1",
    "colorjs.io": "^0.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
