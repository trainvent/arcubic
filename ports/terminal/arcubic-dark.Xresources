! Arcubic Dark — three accents on neutral charcoal surfaces
! Slots 0–7: normal ANSI; 8–15: bright ANSI
! Green and red are status colors; blue is for links; teal, amber and orange carry the identity.
*.background: #111111
*.foreground: #ffffff
*.cursorColor: #0bd8b6
*.selectionBackground: #023b37
*.selectionForeground: #adf0dd
*.color0: #313131
*.color1: #ec6142
*.color2: #33b074
*.color3: #ffca16
*.color4: #3b9eff
*.color5: #d19dff
*.color6: #0bd8b6
*.color7: #b4b4b4
*.color8: #b4b4b4
*.color9: #ffa057
*.color10: #b1f1cb
*.color11: #ffca16
*.color12: #70b8ff
*.color13: #d19dff
*.color14: #0bd8b6
*.color15: #ffffff
