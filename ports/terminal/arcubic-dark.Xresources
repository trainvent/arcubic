*.color2: #8fce85
*.color3: #f0a964
*.color4: #3b9eff
*.color5: #d19dff
*.color6: #0bd8b6
*.color7: #abb7a8
*.color8: #abb7a8
*.color9: #ffa057
*.color10: #d8f0d4
